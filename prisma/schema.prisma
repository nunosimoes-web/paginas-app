generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INDIVIDUAL
  THERAPIST
}

enum PieceType {
  METAPHOR
  REMINDER
  EXERCISE
  REFLECTION
}

enum Plan {
  FREE
  PLUS
  THERAPIST_PRO
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  displayName   String?
  locale        String   @default("pt-PT")
  role          Role     @default(INDIVIDUAL)
  promptHour    Int      @default(8)
  // Opt-in do email diário da peça. Pode desligar-se nas definições / unsubscribe.
  emailDaily    Boolean  @default(true)
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())
  // Camada paga. planSource guarda a origem ("founder" para os amigos atuais,
  // "stripe" para subscrições pagas, null para FREE comum). planRenewsAt é a
  // próxima data de renovação quando aplicável. founder nunca é cobrado.
  plan              Plan     @default(FREE)
  planSource        String?
  stripeCustomerId  String?  @unique
  planRenewsAt      DateTime?
  themes        UserTheme[]
  checkIns      MoodCheckIn[]
  journalEntries JournalEntry[]
  deliveries    PromptDelivery[]
  asClient      ClientLink[] @relation("ClientSide")
  asTherapist   ClientLink[] @relation("TherapistSide")
  resetTokens   PasswordResetToken[]
  purchases     Purchase[]
  bodyEntries   BodyEntry[]
  enrollments   ProgramEnrollment[]
}

// Compras avulsas (one-shot). Ex.: "Relatório 30 dias" do módulo Corpo.
model Purchase {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  // sku estável para identificar o produto comprado (ex.: "body_report_30d").
  sku               String
  stripeSessionId   String   @unique
  stripePaymentIntent String? @unique
  amountCents       Int
  currency          String
  createdAt         DateTime @default(now())
  @@index([userId, sku])
}

// Registo diário do módulo Corpo — entrada por dia, com zona, intensidade (0-10)
// e nota curta. É o input para o "Relatório 30 dias" (PDF/print).
model BodyEntry {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  date       DateTime @default(now())
  region     String
  intensity  Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  @@index([userId, date])
}

// Programa (percurso temático) de N dias. Ex.: "ansiedade" com 21 entradas.
// A estrutura é um array de externalId de ContentPiece em dayStep.
model Program {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleI18n   Json
  summaryI18n Json
  days        Int      @default(21)
  // Array ordenado de externalId das ContentPiece a usar em cada dia do percurso.
  pieceOrder  String[]
  createdAt   DateTime @default(now())
  enrollments ProgramEnrollment[]
}

// Enrollment do utilizador num Program. startedAt marca o dia 1.
model ProgramEnrollment {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId  String
  startedAt  DateTime @default(now())
  completedAt DateTime?
  @@unique([userId, programId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}

model Theme {
  id        String @id @default(cuid())
  slug      String @unique
  nameI18n  Json
  pieces    ContentPiece[]
  userThemes UserTheme[]
}

model UserTheme {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  theme   Theme  @relation(fields: [themeId], references: [id])
  themeId String
  weight  Int    @default(1)
  @@unique([userId, themeId])
}

model ContentPiece {
  id          String   @id @default(cuid())
  externalId  String   @unique
  day         Int
  type        PieceType
  principle   String
  bodyI18n    Json
  moodFit     String[]
  depth       Int      @default(1)
  themeId     String?
  theme       Theme?   @relation(fields: [themeId], references: [id])
  needsReview Boolean  @default(true)
  createdAt   DateTime @default(now())
  deliveries  PromptDelivery[]
}

model PromptDelivery {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  piece       ContentPiece @relation(fields: [pieceId], references: [id])
  pieceId     String
  date        DateTime @default(now())
  opened      Boolean  @default(false)
  // Quando a peça do dia foi enviada por email — idempotência do envio diário.
  emailSentAt DateTime?
  // Medição do email: primeira abertura / primeiro clique e respetivas contagens.
  emailOpenedAt  DateTime?
  emailOpenCount Int      @default(0)
  emailClickedAt DateTime?
  emailClickCount Int     @default(0)
  @@unique([userId, date])
}

model MoodCheckIn {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  mood      Int
  note      String?
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  body      String
  pieceId   String?
  createdAt DateTime @default(now())
}

model ClientLink {
  id          String  @id @default(cuid())
  therapist   User    @relation("TherapistSide", fields: [therapistId], references: [id])
  therapistId String
  // clientId é nulo enquanto o convite está pendente (antes de redimido).
  client      User?   @relation("ClientSide", fields: [clientId], references: [id])
  clientId    String?
  inviteCode  String  @unique
  status      String  @default("pending")
  seededThemes Json?
  createdAt   DateTime @default(now())
  @@unique([therapistId, clientId])
}

// Ephemeral, HMAC-keyed abuse counters only; no visitor profile or raw identifiers.
model PublicFormQuota {
  id        String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
